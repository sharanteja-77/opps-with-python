class shape:
    def area(self):
        print("area")
class circle(shape):
    def area(self):
        return 3.14*4*4
class rectangle(shape):
    def area(self):
        return 10*5
class triangle(shape):
    def area(self):
        return 0.5*10*5
c=circle()
print("circle",c.area())
r=rectangle()
print("rectangle",r.area())
t=triangle()
print("triangle",t.area())  
